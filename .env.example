# Copia a .env y completa valores. Nunca commitear .env

DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require
JWT_SECRET=change_me_dev_only
NODE_ENV=development
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cloudflare R2 (adjuntos clientes)
# Si el bucket tiene jurisdicción EU: https://YOUR_ACCOUNT_ID.eu.r2.cloudflarestorage.com
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=tcgrerp
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
ATTACHMENTS_MAX_BYTES=10485760
# s3 = R2 (producción) | memory = solo dev local (sin R2, no persiste entre reinicios)
ATTACHMENTS_STORAGE=s3
