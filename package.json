{
  "name": "tcg-erp-api",
  "version": "1.0.0",
  "description": "TCG ERP API - Node.js + Hono + Prisma + Postgres",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && tsc",
    "vercel-smoke": "node scripts/vercel-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test:hr": "tsx --test src/modules/hr/hr.integration.test.ts",
    "test:admin": "tsx --test src/modules/admin/admin.integration.test.ts",
    "test:dashboard": "tsx --test src/modules/dashboard/dashboard.integration.test.ts",
    "test:customers": "tsx --test src/modules/customers/customers.integration.test.ts src/modules/customers/attachments.integration.test.ts src/modules/customers/visit-attachments.integration.test.ts",
    "test:appointments": "tsx --test src/modules/appointments/appointments.integration.test.ts",
    "test:integration": "tsx --test src/modules/hr/hr.integration.test.ts src/modules/admin/admin.integration.test.ts src/modules/dashboard/dashboard.integration.test.ts src/modules/customers/customers.integration.test.ts src/modules/customers/attachments.integration.test.ts src/modules/customers/visit-attachments.integration.test.ts src/modules/appointments/appointments.integration.test.ts"
  },
  "keywords": [
    "tcg",
    "erp",
    "api",
    "hono",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@hono/node-server": "^1.8.0",
    "@prisma/client": "^5.7.0",
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "file-type": "^19.6.0",
    "hono": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "prisma": "^5.7.0",
    "sharp": "^0.35.2",
    "swagger-ui-dist": "^5.30.3",
    "uuid": "^9.0.1",
    "yaml": "^2.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
