// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Game {
  pokemon
  yugioh
  magic
  digimon
  one_piece
  dragon_ball
  naruto
  bleach
  final_fantasy
  card_fight_vanguard
  weiss_schwarz
  battle_spirits
  other
}

enum Rarity {
  comun
  infrecuente
  rara
  rara_holo
  rara_secreta
  rara_ultra
  rara_gold
  rara_rainbow
  rara_alternate
  rara_full_art
  rara_charizard
  legendary
  mythic
}

enum Condition {
  mint
  near_mint
  excellent
  very_good
  good
  fair
  poor
  damaged
}

enum Language {
  espanol
  ingles
  japones
  chino
  koreano
  frances
  aleman
  italiano
  portugues
  ruso
}

enum ProductType {
  single
  sellado
  bundle
  collection
}

enum OrderStatus {
  pendiente
  voucher_impreso
  confirmada
  en_proceso
  enviada
  entregada
  completada
  cancelada
  reembolsada
  devuelta
  devuelta_parcial
}

enum OrderChannel {
  tienda_fisica
  online
  telefono
  whatsapp
  redes_sociales
  marketplace
  mayorista
  evento
  other
}

enum DocType {
  boleta
  factura
  nota_credito
  nota_debito
  guia_despacho
  recibo
}

enum CustomerStatus {
  activo
  inactivo
  suspendido
}

enum ReceptionStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

enum TransferStatus {
  PENDIENTE
  EN_TRANSITO
  COMPLETADA
  CANCELADA
}

enum AccountType {
  activo
  pasivo
  patrimonio
  ingreso
  gasto
  costo
}

enum EntryType {
  manual
  automatico
  ajuste
  cierre
}

enum EntryStatus {
  borrador
  aprobado
  contabilizado
  anulado
}

enum EmployeeStatus {
  activo
  inactivo
  suspendido
  licencia
}

enum ContractStatus {
  vigente
  respaldo
  terminado
  suspendido
}

enum PayrollStatus {
  pendiente
  procesada
  pagada
  cancelada
}

enum ScheduleExceptionType {
  override
  off
}

// Models
model Product {
  id              Int          @id @default(autoincrement())
  nombre          String       @db.VarChar(200)
  descripcion     String?      @db.VarChar(1000)
  sku             String?      @unique @db.VarChar(50)
  juego           Game?
  set             String?
  nroColeccionista String?     @map("nro_coleccionista") @db.VarChar(50)
  rareza          Rarity?
  idioma          Language?
  condicion       Condition?
  tipo            ProductType?
  precio          Int          // CLP en pesos enteros
  precioCompra    Int?         @map("precio_compra")
  iva             Int          @default(19)
  stock           Int          @default(0)
  stockMinimo     Int          @default(0) @map("stock_minimo")
  categoria       String
  imagen          String?      @db.Text
  imagenes        String[]     @default([])
  activo          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  // Relations
  stockByBranch   StockByBranch[]
  orderItems      OrderItem[]
  receptionItems  ReceptionItem[]
  transferItems   TransferItem[]
  customerPurchaseItems CustomerPurchaseItem[]
  stockMovements  StockMovement[]

  @@index([sku])
  @@index([categoria])
  @@index([juego])
  @@index([activo])
  @@map("products")
}

model StockByBranch {
  id          String   @id @default(uuid())
  productId   Int      @map("product_id")
  branchId    String   @map("branch_id")
  cantidad    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([branchId])
  @@map("stock_by_branch")
}

model Branch {
  id             String   @id @default(uuid())
  codigo         String   @unique @db.VarChar(20)
  nombre         String   @db.VarChar(200)
  direccion      String   @db.VarChar(500)
  telefono       String?  @db.VarChar(50)
  email          String?  @db.VarChar(255)
  configuracion  Json?
  activa         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  stockByBranch   StockByBranch[]
  orders          Order[]
  receptions      Reception[]
  transfersOrigin Transfer[] @relation("TransferOrigin")
  transfersDest   Transfer[] @relation("TransferDest")
  users           User[]
  employees       Employee[]
  stockMovements  StockMovement[]
  cashSessions    CashSession[]
  returns         Return[]
  customerPurchases CustomerPurchase[]

  @@map("branches")
}

model Customer {
  id              String      @id @default(uuid())
  nombre          String      @db.VarChar(100)
  apellido        String?      @db.VarChar(100)
  email           String?      @unique @db.VarChar(255)
  telefono        String?      @db.VarChar(50)
  rut             String?      @unique @db.VarChar(20)
  direccion       Json?        // JSON object
  canal           String?     @db.VarChar(100)
  estado          CustomerStatus @default(activo)
  creditoTienda   Int         @default(0) @map("credito_tienda")
  fechaRegistro   DateTime    @default(now()) @map("fecha_registro")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")

  // Relations
  orders          Order[]
  visits          CustomerVisit[]
  attachments     CustomerAttachment[]
  purchases       CustomerPurchase[]
  storeCreditMovements StoreCreditMovement[]

  @@index([email])
  @@index([rut])
  @@index([estado])
  @@map("customers")
}

enum CustomerVisitType {
  compra
  venta_a_tienda
  tasacion
  consignacion
  torneo_evento
  consulta
  otro
}

/// Historial de visitas / notas por cliente (texto largo tal cual, fecha del hecho, autor).
model CustomerVisit {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  tipo         CustomerVisitType @default(otro)
  fecha        DateTime
  descripcion  String   @db.Text
  usuarioId    String   @map("usuario_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  usuario  User     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  attachments CustomerVisitAttachment[]
  purchase CustomerPurchase?

  @@index([customerId])
  @@index([fecha])
  @@index([usuarioId])
  @@map("customer_visits")
}

/// Archivos adjuntos por visita (binario en R2/S3; metadata en Postgres).
model CustomerVisitAttachment {
  id                String   @id @default(uuid())
  visitId           String   @map("visit_id")
  originalName      String   @map("original_name") @db.VarChar(255)
  mimeType          String   @map("mime_type") @db.VarChar(127)
  originalSizeBytes Int      @map("original_size_bytes")
  storedSizeBytes   Int      @map("stored_size_bytes")
  storageKey        String   @unique @map("storage_key") @db.VarChar(512)
  descripcion       String?  @db.VarChar(500)
  uploadedById      String   @map("uploaded_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  visit      CustomerVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([visitId, createdAt])
  @@map("customer_visit_attachments")
}

/// Archivos adjuntos por cliente (binario en R2/S3; metadata en Postgres).
model CustomerAttachment {
  id               String   @id @default(uuid())
  customerId       String   @map("customer_id")
  originalName     String   @map("original_name") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(127)
  originalSizeBytes Int     @map("original_size_bytes")
  storedSizeBytes  Int      @map("stored_size_bytes")
  storageKey       String   @unique @map("storage_key") @db.VarChar(512)
  descripcion      String?  @db.VarChar(500)
  uploadedById     String   @map("uploaded_by_id")
  createdAt        DateTime @default(now()) @map("created_at")

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("customer_attachments")
}

model Order {
  id                  String      @id @default(uuid())
  numero              String      @unique @db.VarChar(50)
  clienteId           String      @map("cliente_id")
  vendedorId          String?     @map("vendedor_id")
  estado              OrderStatus @default(pendiente)
  canal               OrderChannel
  tipoDocumento       DocType     @map("tipo_documento")
  subtotal            Int
  descuentoGeneral    Int         @default(0) @map("descuento_general")
  subtotalConDescuento Int        @map("subtotal_con_descuento")
  montoIva            Int         @map("monto_iva")
  costoEnvio          Int         @default(0) @map("costo_envio")
  total               Int
  sucursalId          String      @map("sucursal_id")
  fechaCreacion       DateTime    @default(now()) @map("fecha_creacion")
  fechaActualizacion  DateTime    @updatedAt @map("fecha_actualizacion")
  deletedAt           DateTime?   @map("deleted_at")

  // Relations
  cliente             Customer    @relation(fields: [clienteId], references: [id])
  sucursal            Branch      @relation(fields: [sucursalId], references: [id])
  items               OrderItem[]
  vendedor            User?       @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  payments            Payment[]
  returns             Return[]

  @@index([clienteId])
  @@index([vendedorId])
  @@index([sucursalId])
  @@index([estado])
  @@index([fechaCreacion])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   Int      @map("product_id")
  cantidad    Int
  precioUnitario Int   @map("precio_unitario")
  descuento   Int      @default(0)
  subtotal    Int
  total       Int
  createdAt   DateTime @default(now()) @map("created_at")

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Supplier {
  id          String   @id @default(uuid())
  nombre      String   @db.VarChar(200)
  rut         String   @unique @db.VarChar(20)
  email       String?  @db.VarChar(255)
  telefono    String?  @db.VarChar(50)
  direccion   String?  @db.VarChar(500)
  contacto    String?  @db.VarChar(200)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  receptions  Reception[]

  @@index([rut])
  @@map("suppliers")
}

model Reception {
  id              String          @id @default(uuid())
  numero          String          @unique @db.VarChar(50)
  proveedorId     String          @map("proveedor_id")
  sucursalId      String          @map("sucursal_id")
  fechaRecepcion  DateTime        @map("fecha_recepcion")
  fechaDocumento  DateTime        @map("fecha_documento")
  numeroDocumento String          @map("numero_documento") @db.VarChar(50)
  tipoDocumento   String          @map("tipo_documento") // FACTURA, BOLETA, etc.
  estado          ReceptionStatus @default(PENDIENTE)
  total           Int
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  // Relations
  proveedor       Supplier        @relation(fields: [proveedorId], references: [id])
  sucursal        Branch          @relation(fields: [sucursalId], references: [id])
  items           ReceptionItem[]

  @@index([proveedorId])
  @@index([sucursalId])
  @@index([estado])
  @@map("receptions")
}

model ReceptionItem {
  id          String    @id @default(uuid())
  receptionId String    @map("reception_id")
  productId   Int       @map("product_id")
  cantidad    Int
  precioUnitario Int    @map("precio_unitario")
  subtotal    Int
  total       Int
  createdAt   DateTime  @default(now()) @map("created_at")

  reception   Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@index([receptionId])
  @@index([productId])
  @@map("reception_items")
}

model Transfer {
  id                  String        @id @default(uuid())
  numero              String        @unique @db.VarChar(50)
  sucursalOrigenId    String        @map("sucursal_origen_id")
  sucursalDestinoId   String        @map("sucursal_destino_id")
  fechaTransferencia  DateTime      @map("fecha_transferencia")
  estado              TransferStatus @default(PENDIENTE)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")

  // Relations
  sucursalOrigen      Branch        @relation("TransferOrigin", fields: [sucursalOrigenId], references: [id])
  sucursalDestino     Branch        @relation("TransferDest", fields: [sucursalDestinoId], references: [id])
  items               TransferItem[]

  @@index([sucursalOrigenId])
  @@index([sucursalDestinoId])
  @@index([estado])
  @@map("transfers")
}

model TransferItem {
  id          String   @id @default(uuid())
  transferId  String   @map("transfer_id")
  productId   Int      @map("product_id")
  cantidad    Int
  createdAt   DateTime @default(now()) @map("created_at")

  transfer    Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@map("transfer_items")
}

model Account {
  id          String      @id @default(uuid())
  codigo      String      @unique @db.VarChar(10)
  nombre      String      @db.VarChar(200)
  tipo        AccountType
  nivel       Int
  padreId     String?     @map("padre_id")
  activa      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  // Relations
  padre       Account?    @relation("AccountHierarchy", fields: [padreId], references: [id])
  hijos       Account[]   @relation("AccountHierarchy")
  movimientos EntryMovement[]

  @@index([codigo])
  @@index([tipo])
  @@index([padreId])
  @@map("accounts")
}

model AccountingEntry {
  id          String      @id @default(uuid())
  numero      String      @unique @db.VarChar(50)
  fecha       DateTime
  tipo        EntryType
  estado      EntryStatus @default(borrador)
  totalDebe   Int         @map("total_debe")
  totalHaber  Int         @map("total_haber")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  // Relations
  movimientos EntryMovement[]

  @@index([fecha])
  @@index([estado])
  @@map("accounting_entries")
}

model EntryMovement {
  id          String          @id @default(uuid())
  entryId     String          @map("entry_id")
  accountId   String          @map("account_id")
  debe        Int             @default(0)
  haber       Int             @default(0)
  descripcion String?         @db.VarChar(500)
  createdAt   DateTime        @default(now()) @map("created_at")

  entry       AccountingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     Account         @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("entry_movements")
}

model Position {
  id                String    @id @default(uuid())
  nombre            String    @db.VarChar(200)
  descripcion       String?   @db.VarChar(500)
  departamento      String    @db.VarChar(120)
  nivelJerarquico   Int       @map("nivel_jerarquico")
  sueldoMinimo      Int       @map("sueldo_minimo")
  sueldoMaximo      Int       @map("sueldo_maximo")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  employees Employee[]

  @@index([departamento])
  @@map("positions")
}

model Employee {
  id                String         @id @default(uuid())
  rut               String         @unique @db.VarChar(20)
  nombre            String         @db.VarChar(100)
  apellidoPaterno   String         @map("apellido_paterno") @db.VarChar(100)
  apellidoMaterno   String         @map("apellido_materno") @db.VarChar(100)
  email             String         @unique @db.VarChar(255)
  telefono          String?        @db.VarChar(50)
  direccion         Json?
  fechaNacimiento   DateTime       @map("fecha_nacimiento")
  fechaIngreso      DateTime       @map("fecha_ingreso")
  estado            EmployeeStatus @default(activo)
  branchId          String?        @map("branch_id")
  positionId        String?        @map("position_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  branch            Branch?        @relation(fields: [branchId], references: [id])
  position          Position?      @relation(fields: [positionId], references: [id])
  bankData          EmployeeBankData?
  socialSecurity    EmployeeSocialSecurity?
  contracts         Contract[]
  payrolls          Payroll[]
  contributionSummaries EmployeeContributionSummary[]
  scheduleTemplates EmployeeScheduleTemplate[]
  scheduleExceptions EmployeeScheduleException[]

  @@index([rut])
  @@index([email])
  @@index([estado])
  @@index([positionId])
  @@map("employees")
}

model EmployeeScheduleTemplate {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  dayOfWeek    Int      @map("day_of_week") @db.SmallInt
  startTime    String   @map("start_time") @db.VarChar(5)
  endTime      String   @map("end_time") @db.VarChar(5)
  isActive     Boolean  @default(true) @map("is_active")
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveTo  DateTime? @map("effective_to") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([employeeId, dayOfWeek, isActive])
  @@index([effectiveFrom, effectiveTo])
  @@map("employee_schedule_templates")
}

model EmployeeScheduleException {
  id           String                @id @default(uuid())
  employeeId   String                @map("employee_id")
  date         DateTime              @db.Date
  type         ScheduleExceptionType
  startTime    String?               @map("start_time") @db.VarChar(5)
  endTime      String?               @map("end_time") @db.VarChar(5)
  note         String?               @db.VarChar(500)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
  @@index([employeeId, type, date])
  @@map("employee_schedule_exceptions")
}

model EmployeeBankData {
  id           String   @id @default(uuid())
  employeeId   String   @unique @map("employee_id")
  banco        String   @db.VarChar(120)
  tipoCuenta   String   @map("tipo_cuenta") @db.VarChar(50)
  numeroCuenta String   @map("numero_cuenta") @db.VarChar(50)
  rutTitular   String   @map("rut_titular") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_bank_data")
}

model EmployeeSocialSecurity {
  id            String   @id @default(uuid())
  employeeId    String   @unique @map("employee_id")
  afp           String   @db.VarChar(50)
  salud         String   @db.VarChar(50)
  isapre        String?  @db.VarChar(120)
  mutual        Boolean  @default(false)
  afc           Boolean  @default(false)
  porcentajeAFC Float?   @map("porcentaje_afc")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_social_security")
}

model Contract {
  id              String         @id @default(uuid())
  employeeId      String         @map("employee_id")
  numeroContrato  String?        @unique @map("numero_contrato") @db.VarChar(50)
  tipo            String         @db.VarChar(50)
  jornada         String?        @db.VarChar(50)
  fechaInicio     DateTime       @map("fecha_inicio")
  fechaTermino    DateTime?      @map("fecha_termino")
  sueldoBase      Int            @map("sueldo_base")
  estado          ContractStatus @default(vigente)
  observaciones   String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrolls        Payroll[]

  @@index([employeeId])
  @@index([estado])
  @@map("contracts")
}

model Payroll {
  id                  String        @id @default(uuid())
  employeeId          String        @map("employee_id")
  contractId          String?       @map("contract_id")
  periodo             String        @db.VarChar(7)
  sueldoBase          Int           @map("sueldo_base")
  totalHaberes        Int           @default(0) @map("total_haberes")
  totalDescuentos     Int           @default(0) @map("total_descuentos")
  totalImposiciones   Int           @default(0) @map("total_imposiciones")
  liquido             Int
  estado              PayrollStatus @default(pendiente)
  fechaGeneracion     DateTime?     @map("fecha_generacion") @db.Date
  fechaPago           DateTime?     @map("fecha_pago") @db.Date
  observaciones       String?       @db.Text
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  employee            Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contract            Contract?     @relation(fields: [contractId], references: [id])
  earnings            PayrollEarning[]
  deductions          PayrollDeduction[]
  impositionLines     PayrollImpositionLine[]

  @@unique([employeeId, periodo])
  @@index([periodo])
  @@index([estado])
  @@map("payrolls")
}

model PayrollEarning {
  id            String   @id @default(uuid())
  payrollId     String   @map("payroll_id")
  tipo          String   @db.VarChar(80)
  descripcion   String   @db.VarChar(500)
  monto         Int
  esImponible   Boolean  @map("es_imponible")
  esTributable  Boolean  @map("es_tributable")

  payroll       Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
  @@map("payroll_earnings")
}

model PayrollDeduction {
  id             String   @id @default(uuid())
  payrollId      String   @map("payroll_id")
  tipo           String   @db.VarChar(80)
  descripcion    String   @db.VarChar(500)
  porcentaje     Float?
  monto          Int
  esLegal        Boolean  @map("es_legal")
  esVoluntario   Boolean  @map("es_voluntario")

  payroll        Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
  @@map("payroll_deductions")
}

model PayrollImpositionLine {
  id             String   @id @default(uuid())
  payrollId      String   @map("payroll_id")
  tipo           String   @db.VarChar(80)
  descripcion    String   @db.VarChar(500)
  porcentaje     Float?
  baseImponible  Int      @map("base_imponible")
  monto          Int
  esObligatoria  Boolean  @map("es_obligatoria")

  payroll        Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
  @@map("payroll_imposition_lines")
}

model EmployeeContributionSummary {
  id                  String   @id @default(uuid())
  employeeId          String   @map("employee_id")
  periodo             String   @db.VarChar(7)
  fechaGeneracion     DateTime @map("fecha_generacion") @db.Date
  totalImposiciones   Int      @map("total_imposiciones")
  afp                 Json
  salud               Json
  afc                 Json
  mutual              Json

  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, periodo])
  @@index([periodo])
  @@map("employee_contribution_summaries")
}

model HrCalculationParameters {
  id                   String   @id @default("default")
  porcentajeAFP        Float    @map("porcentaje_afp")
  porcentajeSalud      Float    @map("porcentaje_salud")
  porcentajeAFC        Float    @map("porcentaje_afc")
  porcentajeMutual     Float    @map("porcentaje_mutual")
  tramoImpuesto        String   @map("tramo_impuesto") @db.VarChar(50)
  porcentajeImpuesto   Float    @map("porcentaje_impuesto")
  rebajaImpuesto       Int      @map("rebaja_impuesto")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("hr_calculation_parameters")
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique @db.VarChar(50)
  email       String   @unique @db.VarChar(255)
  passwordHash String  @map("password_hash") @db.VarChar(255)
  nombre      String   @db.VarChar(100)
  apellido    String   @db.VarChar(100)
  telefono    String?  @db.VarChar(50)
  avatar      String?  @db.VarChar(500)
  ultimoAcceso DateTime? @map("ultimo_acceso")
  activo      Boolean  @default(true)
  sucursalId  String   @map("sucursal_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  sucursal    Branch   @relation(fields: [sucursalId], references: [id])
  userRoles   UserRole[]
  refreshTokens RefreshToken[]
  sales Order[]
  stockMovements StockMovement[]
  openedCashSessions CashSession[] @relation("CashSessionOpenedBy")
  closedCashSessions CashSession[] @relation("CashSessionClosedBy")
  customerVisits CustomerVisit[]
  customerAttachments CustomerAttachment[]
  customerVisitAttachments CustomerVisitAttachment[]
  returns Return[]
  customerPurchases CustomerPurchase[]
  storeCreditMovements StoreCreditMovement[]
  auditLogs AuditLog[]

  @@index([username])
  @@index([email])
  @@index([sucursalId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String?  @unique @db.VarChar(500)
  tokenHash String?  @unique @map("token_hash") @db.VarChar(64)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model GeneratedReport {
  id          String    @id @default(uuid())
  tipo        String    @db.VarChar(80)
  titulo      String?   @db.VarChar(300)
  estado      String    @default("completado") @db.VarChar(40)
  parametros  Json?
  resultado   String?   @db.Text
  formato     String?   @db.VarChar(20)
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([tipo])
  @@index([createdAt])
  @@map("generated_reports")
}

model Role {
  id          String   @id @default(uuid())
  nombre      String   @unique @db.VarChar(50)
  descripcion String   @db.VarChar(500)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  userRoles   UserRole[]
  rolePermissions RolePermission[]

  @@index([nombre])
  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id          String   @id @default(uuid())
  nombre      String   @unique @db.VarChar(100)
  recurso     String   @db.VarChar(50)
  accion      String   @db.VarChar(50)
  categoria   String   @default("general") @db.VarChar(50)
  descripcion String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  rolePermissions RolePermission[]

  @@index([recurso, accion])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Setting {
  id          String   @id @default(uuid())
  clave       String   @unique @db.VarChar(100)
  valor       String   @db.Text
  tipo        String   @default("string") @db.VarChar(50)
  categoria   String   @db.VarChar(50)
  descripcion String?  @db.VarChar(500)
  editable    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([categoria])
  @@map("settings")
}


enum StockMovementType {
  venta
  recepcion
  transferencia_salida
  transferencia_entrada
  ajuste
  devolucion
  compra_cliente
}

enum StockMovementRefType {
  order
  reception
  transfer
  return
  purchase
}

model StockMovement {
  id           String                @id @default(uuid())
  productId    Int                   @map("product_id")
  branchId     String                @map("branch_id")
  type         StockMovementType
  quantity     Int
  balanceAfter Int                   @map("balance_after")
  reason       String?
  refType      StockMovementRefType? @map("ref_type")
  refId        String?               @map("ref_id")
  userId       String                @map("user_id")
  createdAt    DateTime              @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([branchId, createdAt])
  @@index([type, createdAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

enum PaymentMethod {
  efectivo
  debito
  credito
  transferencia
  credito_tienda
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @map("order_id")
  method        PaymentMethod
  amount        Int
  reference     String?
  cashSessionId String?       @map("cash_session_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  order       Order        @relation(fields: [orderId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([cashSessionId, method])
  @@map("payments")
}

enum CashSessionStatus {
  abierta
  cerrada
}

model CashSession {
  id             String            @id @default(uuid())
  branchId       String            @map("branch_id")
  userId         String            @map("user_id")
  openedAt       DateTime          @default(now()) @map("opened_at")
  openingAmount  Int               @map("opening_amount")
  closedAt       DateTime?         @map("closed_at")
  closedById     String?           @map("closed_by_id")
  countedAmount  Int?              @map("counted_amount")
  expectedAmount Int?              @map("expected_amount")
  difference     Int?
  notes          String?
  status         CashSessionStatus @default(abierta)

  branch   Branch    @relation(fields: [branchId], references: [id])
  openedBy User      @relation("CashSessionOpenedBy", fields: [userId], references: [id])
  closedBy User?     @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  payments Payment[]

  returns Return[]
  customerPurchases CustomerPurchase[]

  // El índice único parcial para cajas abiertas se define en la migración.
  @@index([branchId, openedAt])
  @@index([openedAt])
  @@map("cash_sessions")
}

model Return {
  id            String        @id @default(uuid())
  orderId       String        @map("order_id")
  idempotencyKey String       @unique @map("idempotency_key")
  reason        String
  refundMethod  PaymentMethod @map("refund_method")
  refundAmount  Int           @map("refund_amount")
  userId        String        @map("user_id")
  cashSessionId String?       @map("cash_session_id")
  branchId      String        @map("branch_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  order       Order        @relation(fields: [orderId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  branch      Branch       @relation(fields: [branchId], references: [id])
  items       ReturnItem[]

  @@index([orderId, createdAt])
  @@index([cashSessionId])
  @@index([branchId, createdAt])
  @@index([createdAt])
  @@map("returns")
}

model ReturnItem {
  id          String @id @default(uuid())
  returnId    String @map("return_id")
  orderItemId String @map("order_item_id")
  quantity    Int

  return    Return    @relation(fields: [returnId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}

enum StoreCreditRefType {
  order
  return
  purchase
}

model StoreCreditMovement {
  id         String             @id @default(uuid())
  customerId String             @map("customer_id")
  amount     Int
  reason     String
  refType    StoreCreditRefType @map("ref_type")
  refId      String             @map("ref_id")
  userId     String             @map("user_id")
  createdAt  DateTime           @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([customerId, createdAt])
  @@index([refType, refId])
  @@map("store_credit_movements")
}

enum CustomerPurchasePaymentMethod {
  efectivo
  credito_tienda
  transferencia
}

model CustomerPurchase {
  id            String                        @id @default(uuid())
  customerId    String                        @map("customer_id")
  branchId      String                        @map("branch_id")
  total         Int
  paymentMethod CustomerPurchasePaymentMethod @map("payment_method")
  notes         String?
  userId        String                        @map("user_id")
  cashSessionId String?                       @map("cash_session_id")
  visitId       String                        @unique @map("visit_id")
  createdAt     DateTime                      @default(now()) @map("created_at")

  customer    Customer               @relation(fields: [customerId], references: [id])
  branch      Branch                 @relation(fields: [branchId], references: [id])
  user        User                   @relation(fields: [userId], references: [id])
  cashSession CashSession?           @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  visit       CustomerVisit          @relation(fields: [visitId], references: [id])
  items       CustomerPurchaseItem[]

  @@index([customerId, createdAt])
  @@index([cashSessionId])
  @@map("customer_purchases")
}

model CustomerPurchaseItem {
  id         String     @id @default(uuid())
  purchaseId String     @map("purchase_id")
  productId  Int        @map("product_id")
  quantity   Int
  unitPrice  Int        @map("unit_price")
  condition  Condition?

  purchase CustomerPurchase @relation(fields: [purchaseId], references: [id])
  product  Product          @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@map("customer_purchase_items")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  method    String
  path      String
  status    Int
  entity    String?
  entityId  String?  @map("entity_id")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
