{
  "functions": {
    "api/[[...hono]].ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/health", "dest": "/api/[[...hono]].ts" },
    { "src": "/api-docs", "dest": "/api/[[...hono]].ts" },
    { "src": "/api-docs/(.*)", "dest": "/api/[[...hono]].ts" },
    { "src": "/api/(.*)", "dest": "/api/[[...hono]].ts" }
  ]
}

